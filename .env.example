# Copy this file to ".env.local" and paste your Mapbox PUBLIC token (starts with pk.)
# .env.local is ignored by Git, so your token is never uploaded to GitHub.
#
# Note: a public token is still visible inside the published website.
# Protect it with URL restrictions in your Mapbox account (Tokens page).
VITE_MAPBOX_TOKEN=pk.paste_your_token_here

# OPTIONAL - free Geoapify key (https://myprojects.geoapify.com) for searching Malaysian
# street names and neighbourhoods from OpenStreetMap. Leave as-is to use Mapbox search only.
VITE_GEOAPIFY_KEY=paste_your_geoapify_key_here
